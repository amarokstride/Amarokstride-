<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive OAuth tokens, emergency SOS contacts, and Firebase App Check prefs from cloud backup -->
        <exclude domain="sharedpref" path="striders_oauth_tokens_v1.xml" />
        <exclude domain="sharedpref" path="striders_howl_sos_prefs.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.debug.store.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude private OAuth session tokens and App Check state from device-to-device transfer -->
        <exclude domain="sharedpref" path="striders_oauth_tokens_v1.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.debug.store.xml" />
    </device-transfer>
</data-extraction-rules>
