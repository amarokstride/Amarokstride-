# Public OAuth2 Client IDs (non-secret values used to launch browser sign-in).
# All private OAuth client secrets (COROS_CLIENT_SECRET, STRAVA_CLIENT_SECRET, GARMIN_CLIENT_SECRET)
# live exclusively on the server in Firebase Cloud Functions Secret Manager (see functions/.env.example)
# and are NEVER bundled into the Android APK/AAB.

# COROS Open API public Client ID (optional - GPX/TCX import and Health Connect work without this).
COROS_CLIENT_ID=YOUR_COROS_CLIENT_ID

# Strava OAuth2 public Client ID (optional - GPX/TCX import works without this).
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID

# Garmin Connect OAuth2 public Client ID (optional - GPX/TCX import and Health Connect work without this).
GARMIN_CLIENT_ID=YOUR_GARMIN_CLIENT_ID

# Optional HTTPS base URL override for Firebase Cloud Functions OAuth endpoints.
# Leave as AUTO_FIREBASE_FUNCTIONS to default automatically to https://us-central1-<firebase-project-id>.cloudfunctions.net
OAUTH_FUNCTIONS_BASE_URL=AUTO_FIREBASE_FUNCTIONS
