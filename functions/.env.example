# Server-side OAuth configuration for Firebase Cloud Functions ONLY.
# NEVER add client secrets to the Android app's root .env or BuildConfig.
#
# In production, store secrets in Google Cloud / Firebase Secret Manager:
#   firebase functions:secrets:set COROS_CLIENT_SECRET
#   firebase functions:secrets:set STRAVA_CLIENT_SECRET
#   firebase functions:secrets:set GARMIN_CLIENT_SECRET
#
# Set public OAuth Client IDs in functions/.env.<project-id> or Firebase params:
COROS_CLIENT_ID=YOUR_COROS_CLIENT_ID
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
GARMIN_CLIENT_ID=YOUR_GARMIN_CLIENT_ID
